{{ header }}
{% for case in cases %}
@test {{ case["descriptions"] | join(":") | quote }} {
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
{%- if case["property"] == "allergicTo" %}
    run bash {{ solution }} {{ case["input"]["score"] }} allergic_to {{ case["input"]["item"] }}

    assert_success
    assert_output "{{ case["expected"] }}"
{%- else %}
    run bash {{ solution }} {{ case["input"]["score"] }} list

    assert_success
    assert_output "{{ case["expected"] | join(" ") }}"
{%- endif %}
}
{% endfor %}

# Track-specific test: verify score with higher-order bits (> 512)
@test 'list when::ignore non allergen score parts above 512' {
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} 513 list

    assert_success
    assert_output "eggs"
}
